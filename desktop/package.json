{
  "name": "usagehub-desktop",
  "version": "0.8.6",
  "description": "UsageHub cross-platform desktop client (Electron) wrapping the local web dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:web": "cd ../web && npm run build",
    "build": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux"
  },
  "build": {
    "appId": "com.lune.openusagebar",
    "productName": "UsageHub",
    "buildVersion": "28",
    "buildNumber": "28",
    "extraMetadata": {
      "buildVersion": "28",
      "buildNumber": "28"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "build_identity_copy.js",
      "collector_runtime.js",
      "gateway_proxy.js",
      "main.js",
      "plugin_connection_proxy.js",
      "package.json",
      "product_version_truth.js",
      "gateway_account_operations.js",
      "runtime_capability.js",
      "settings_runtime.js",
      "tray_state.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../openusage_bar/resources/artifact-build-identity.v1.json",
        "to": "product-build-identity.v1.json"
      }
    ],
    "directories": {
      "output": "../dist-desktop"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "../dist-collector/openusage-collector",
          "to": "collector/openusage-collector"
        },
        {
          "from": "../dist-settings/openusage-settings",
          "to": "settings/openusage-settings"
        },
        {
          "from": "../dist-bridge/openusage-plugin-bridge",
          "to": "bridge/openusage-plugin-bridge"
        },
        {
          "from": "assets/trayTemplate.png",
          "to": "trayTemplate.png"
        },
        {
          "from": "assets/trayTemplate@2x.png",
          "to": "trayTemplate@2x.png"
        }
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../dist-collector/openusage-collector.exe",
          "to": "collector/openusage-collector.exe"
        },
        {
          "from": "../dist-settings/openusage-settings.exe",
          "to": "settings/openusage-settings.exe"
        },
        {
          "from": "../dist-bridge/openusage-plugin-bridge.exe",
          "to": "bridge/openusage-plugin-bridge.exe"
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "desktop": {
        "entry": {
          "X-AppImage-Version": "28"
        }
      },
      "extraResources": [
        {
          "from": "../dist-collector/openusage-collector",
          "to": "collector/openusage-collector"
        },
        {
          "from": "../dist-settings/openusage-settings",
          "to": "settings/openusage-settings"
        },
        {
          "from": "../dist-bridge/openusage-plugin-bridge",
          "to": "bridge/openusage-plugin-bridge"
        }
      ]
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "author": "Lune"
}
